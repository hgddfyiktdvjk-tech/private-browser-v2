<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="AppTheme" parent="Theme.AppCompat.NoActionBar">
        <item name="colorPrimary">#000000</item>
        <item name="colorPrimaryDark">#000000</item>
        <item name="colorAccent">#0A84FF</item>
        <item name="android:windowBackground">#000000</item>
        <item name="android:textColorPrimary">#FFFFFF</item>
        <item name="alertDialogTheme">@style/CustomDialogTheme</item>
        <item name="android:alertDialogTheme">@style/CustomDialogTheme</item>
        <item name="popupMenuStyle">@style/CustomPopupMenu</item>
        <item name="android:popupMenuStyle">@style/CustomPopupMenu</item>
    </style>

    <style name="CustomDialogTheme" parent="Theme.AppCompat.Dialog.Alert">
        <item name="android:windowBackground">@drawable/bg_dialog_ios</item>
        <item name="colorAccent">#0A84FF</item>
        <item name="android:textColorPrimary">#FFFFFF</item>
        <item name="android:textColorSecondary">#98989F</item>
        <item name="android:windowMinWidthMajor">80%</item>
        <item name="android:windowMinWidthMinor">80%</item>
        <item name="android:windowTitleStyle">@style/DialogTitleIOS</item>
        <item name="buttonBarButtonStyle">@style/DialogButtonIOS</item>
        <item name="android:buttonBarButtonStyle">@style/DialogButtonIOS</item>
        <item name="android:listDivider">@drawable/divider_ios</item>
    </style>

    <style name="DialogTitleIOS" parent="android:TextAppearance.DeviceDefault.DialogWindowTitle">
        <item name="android:textColor">#FFFFFF</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textSize">17sp</item>
        <item name="android:gravity">center</item>
    </style>

    <style name="DialogButtonIOS" parent="Widget.AppCompat.Button.Borderless">
        <item name="android:textColor">#0A84FF</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textSize">17sp</item>
        <item name="android:textStyle">normal</item>
    </style>

    <style name="CustomPopupMenu" parent="Widget.AppCompat.PopupMenu">
        <item name="android:popupBackground">@drawable/bg_dialog_ios</item>
    </style>
</resources>
