<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <FrameLayout
        android:id="@+id/homeScreen"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@drawable/bg_gradient">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:paddingTop="48dp"
            android:paddingBottom="70dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="20dp"
                android:layout_marginBottom="24dp"
                android:background="@drawable/bg_search_bar"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:paddingHorizontal="16dp"
                android:paddingVertical="12dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="🔍"
                    android:textSize="18sp"
                    android:layout_marginEnd="8dp" />

                <EditText
                    android:id="@+id/homeSearchBar"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:background="@null"
                    android:hint="ابحث أو اكتب رابط"
                    android:textColor="#FFFFFF"
                    android:textColorHint="#AAAAAA"
                    android:imeOptions="actionGo"
                    android:inputType="textUri"
                    android:singleLine="true" />
            </LinearLayout>

            <ScrollView
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1">

                <GridLayout
                    android:id="@+id/gridShortcuts"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:columnCount="4"
                    android:padding="12dp" />
            </ScrollView>

        </LinearLayout>
    </FrameLayout>

    <FrameLayout
        android:id="@+id/browserContainer"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:visibility="gone">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:background="#1A1030"
                android:padding="8dp"
                android:gravity="center_vertical">

                <TextView
                    android:id="@+id/urlDisplay"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:textColor="#FFFFFF"
                    android:singleLine="true"
                    android:ellipsize="middle"
                    android:text="" />

                <ImageButton
                    android:id="@+id/menuButtonTop"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:background="@null"
                    android:padding="8dp"
                    android:scaleType="fitCenter"
                    android:src="@drawable/ic_menu"
                    android:contentDescription="قائمة" />
            </LinearLayout>

            <ProgressBar
                android:id="@+id/progressBar"
                style="?android:attr/progressBarStyleHorizontal"
                android:layout_width="match_parent"
                android:layout_height="4dp"
                android:max="100"
                android:visibility="gone" />

            <androidx.swiperefreshlayout.widget.SwipeRefreshLayout
                android:id="@+id/swipeRefresh"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1">

                <FrameLayout
                    android:id="@+id/webViewContainer"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent" />
            </androidx.swiperefreshlayout.widget.SwipeRefreshLayout>
        </LinearLayout>
    </FrameLayout>

    <LinearLayout
        android:id="@+id/bottomBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:orientation="horizontal"
        android:background="@drawable/bg_bottom_bar"
        android:paddingVertical="10dp"
        android:gravity="center">

        <ImageButton
            android:id="@+id/backButton"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_weight="1"
            android:background="@null"
            android:padding="12dp"
            android:scaleType="fitCenter"
            android:src="@drawable/ic_back"
            android:contentDescription="رجوع" />

        <ImageButton
            android:id="@+id/homeButton"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_weight="1"
            android:background="@null"
            android:padding="12dp"
            android:scaleType="fitCenter"
            android:src="@drawable/ic_home"
            android:contentDescription="الرئيسية" />

        <ImageButton
            android:id="@+id/menuButton"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_weight="1"
            android:background="@null"
            android:padding="12dp"
            android:scaleType="fitCenter"
            android:src="@drawable/ic_menu"
            android:contentDescription="القائمة" />

        <ImageButton
            android:id="@+id/downloadsButton"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_weight="1"
            android:background="@null"
            android:padding="12dp"
            android:scaleType="fitCenter"
            android:src="@drawable/ic_download"
            android:contentDescription="التحميلات" />

        <Button
            android:id="@+id/tabsButton"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:background="@null"
            android:textColor="#FFFFFF"
            android:text="1" />
    </LinearLayout>

    <ImageButton
        android:id="@+id/cyberFab"
        android:layout_width="60dp"
        android:layout_height="60dp"
        android:layout_gravity="bottom|end"
        android:layout_marginEnd="16dp"
        android:layout_marginBottom="86dp"
        android:background="@drawable/bg_fab_glow"
        android:padding="16dp"
        android:scaleType="fitCenter"
        android:src="@drawable/ic_terminal"
        android:contentDescription="الوضع السيبراني"
        android:elevation="10dp" />

    <FrameLayout
        android:id="@+id/fullscreenContainer"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#000000"
        android:visibility="gone" />

    <FrameLayout
        android:id="@+id/lockOverlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#0D0A1E"
        android:visibility="visible">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:orientation="vertical"
            android:gravity="center">

            <ImageButton
                android:id="@+id/lockIcon"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:background="@null"
                android:padding="4dp"
                android:scaleType="fitCenter"
                android:src="@drawable/ic_lock"
                android:contentDescription="مقفل"
                android:layout_marginBottom="12dp"
                android:clickable="false"
                android:focusable="false" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="التطبيق مقفل"
                android:textColor="#FFFFFF"
                android:textSize="20sp"
                android:layout_marginBottom="16dp" />

            <Button
                android:id="@+id/unlockButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="فتح القفل" />
        </LinearLayout>
    </FrameLayout>

    <FrameLayout
        android:id="@+id/cyberContainer"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@drawable/bg_cyber_container"
        android:visibility="gone">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:paddingHorizontal="16dp"
                android:paddingTop="20dp"
                android:paddingBottom="14dp"
                android:gravity="center_vertical">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="horizontal"
                    android:background="@drawable/bg_cyber_header_badge"
                    android:paddingHorizontal="14dp"
                    android:paddingVertical="8dp"
                    android:gravity="center_vertical">

                    <ImageButton
                        android:layout_width="20dp"
                        android:layout_height="20dp"
                        android:background="@null"
                        android:padding="0dp"
                        android:scaleType="fitCenter"
                        android:src="@drawable/ic_terminal"
                        android:contentDescription=""
                        android:clickable="false"
                        android:focusable="false"
                        android:layout_marginEnd="8dp" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="الوضع السيبراني"
                        android:textColor="#00FF41"
                        android:textSize="15sp"
                        android:fontFamily="monospace"
                        android:textStyle="bold" />
                </LinearLayout>

                <ImageButton
                    android:id="@+id/cyberCloseButton"
                    android:layout_width="38dp"
                    android:layout_height="38dp"
                    android:layout_marginStart="10dp"
                    android:background="@null"
                    android:padding="4dp"
                    android:scaleType="fitCenter"
                    android:src="@drawable/ic_close_circle"
                    android:contentDescription="إغلاق" />
            </LinearLayout>

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="@drawable/divider_glow" />

            <FrameLayout
                android:id="@+id/cyberEditorArea"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:padding="18dp">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:text="// منطقة المحرر — قريبًا"
                    android:textColor="#3DFF7A"
                    android:textSize="14sp"
                    android:fontFamily="monospace"
                    android:alpha="0.6" />
            </FrameLayout>

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="@drawable/divider_glow" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:padding="12dp"
                android:gravity="center">

                <Button
                    android:id="@+id/cyberFilesButton"
                    android:layout_width="0dp"
                    android:layout_height="64dp"
                    android:layout_weight="1"
                    android:layout_margin="5dp"
                    android:background="@drawable/bg_cyber_button_selector"
                    android:drawableTop="@drawable/ic_files"
                    android:drawablePadding="4dp"
                    android:textColor="#00FF41"
                    android:textSize="10sp"
                    android:fontFamily="monospace"
                    android:text="ملفات" />

                <Button
                    android:id="@+id/cyberTerminalButton"
                    android:layout_width="0dp"
                    android:layout_height="64dp"
                    android:layout_weight="1"
                    android:layout_margin="5dp"
                    android:background="@drawable/bg_cyber_button_selector"
                    android:drawableTop="@drawable/ic_terminal"
                    android:drawablePadding="4dp"
                    android:textColor="#00FF41"
                    android:textSize="10sp"
                    android:fontFamily="monospace"
                    android:text="ترمينال" />

                <Button
                    android:id="@+id/cyberPackagesButton"
                    android:layout_width="0dp"
                    android:layout_height="64dp"
                    android:layout_weight="1"
                    android:layout_margin="5dp"
                    android:background="@drawable/bg_cyber_button_selector"
                    android:drawableTop="@drawable/ic_package"
                    android:drawablePadding="4dp"
                    android:textColor="#00FF41"
                    android:textSize="10sp"
                    android:fontFamily="monospace"
                    android:text="مكتبات" />

                <Button
                    android:id="@+id/cyberSnippetsButton"
                    android:layout_width="0dp"
                    android:layout_height="64dp"
                    android:layout_weight="1"
                    android:layout_margin="5dp"
                    android:background="@drawable/bg_cyber_button_selector"
                    android:drawableTop="@drawable/ic_snippet"
                    android:drawablePadding="4dp"
                    android:textColor="#00FF41"
                    android:textSize="10sp"
                    android:fontFamily="monospace"
                    android:text="أكواد" />
            </LinearLayout>
        </LinearLayout>

        <FrameLayout
            android:id="@+id/cyberPanel"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_marginTop="76dp"
            android:layout_marginBottom="92dp"
            android:layout_marginHorizontal="14dp"
            android:background="@drawable/bg_cyber_panel_v2"
            android:elevation="6dp"
            android:visibility="gone">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:orientation="vertical"
                android:padding="18dp">

                <TextView
                    android:id="@+id/cyberPanelTitle"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text=""
                    android:textColor="#00FF41"
                    android:textSize="16sp"
                    android:fontFamily="monospace"
                    android:textStyle="bold"
                    android:layout_marginBottom="4dp" />

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:layout_marginBottom="14dp"
                    android:background="@drawable/divider_glow" />

                <TextView
                    android:id="@+id/cyberPanelContent"
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:layout_weight="1"
                    android:text="قريبًا..."
                    android:textColor="#66FF8A"
                    android:textSize="13sp"
                    android:fontFamily="monospace" />
            </LinearLayout>
        </FrameLayout>

    </FrameLayout>

</FrameLayout>
