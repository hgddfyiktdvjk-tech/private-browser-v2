<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <FrameLayout
        android:id="@+id/homeScreen"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@drawable/bg_gradient_v2">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:paddingTop="56dp"
            android:paddingBottom="80dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="24dp"
                android:layout_marginBottom="16dp"
                android:text="متصفحك الخاص"
                android:textColor="#FFFFFF"
                android:textSize="22sp"
                android:textStyle="bold" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="20dp"
                android:layout_marginBottom="28dp"
                android:background="@drawable/bg_search_bar_v2"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:paddingHorizontal="18dp"
                android:paddingVertical="14dp"
                android:elevation="4dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="🔍"
                    android:textSize="18sp"
                    android:layout_marginEnd="10dp" />

                <EditText
                    android:id="@+id/homeSearchBar"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:background="@null"
                    android:hint="ابحث أو اكتب رابط"
                    android:textColor="#FFFFFF"
                    android:textColorHint="#99FFFFFF"
                    android:textSize="15sp"
                    android:imeOptions="actionGo"
                    android:inputType="textUri"
                    android:singleLine="true" />
            </LinearLayout>

            <ScrollView
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1">

                <GridLayout
                    android:id="@+id/gridShortcuts"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:columnCount="4"
                    android:padding="14dp" />
            </ScrollView>

        </LinearLayout>
    </FrameLayout>

    <FrameLayout
        android:id="@+id/browserContainer"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:visibility="gone">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:background="@drawable/bg_top_bar_v2"
                android:paddingHorizontal="16dp"
                android:paddingVertical="12dp"
                android:gravity="center_vertical"
                android:elevation="3dp">

                <TextView
                    android:id="@+id/urlDisplay"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:textColor="#FFFFFF"
                    android:textSize="13sp"
                    android:singleLine="true"
                    android:ellipsize="middle"
                    android:text="" />

                <ImageButton
                    android:id="@+id/menuButtonTop"
                    android:layout_width="42dp"
                    android:layout_height="42dp"
                    android:background="@drawable/bg_bottom_button_ripple"
                    android:padding="9dp"
                    android:scaleType="fitCenter"
                    android:src="@drawable/ic_menu"
                    android:contentDescription="قائمة" />
            </LinearLayout>

            <ProgressBar
                android:id="@+id/progressBar"
                style="?android:attr/progressBarStyleHorizontal"
                android:layout_width="match_parent"
                android:layout_height="3dp"
                android:max="100"
                android:visibility="gone" />

            <androidx.swiperefreshlayout.widget.SwipeRefreshLayout
                android:id="@+id/swipeRefresh"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1">

                <FrameLayout
                    android:id="@+id/webViewContainer"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent" />
            </androidx.swiperefreshlayout.widget.SwipeRefreshLayout>
        </LinearLayout>
    </FrameLayout>

    <LinearLayout
        android:id="@+id/bottomBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:orientation="horizontal"
        android:background="@drawable/bg_bottom_bar_v2"
        android:paddingVertical="14dp"
        android:paddingHorizontal="8dp"
        android:gravity="center"
        android:elevation="10dp">

        <ImageButton
            android:id="@+id/backButton"
            android:layout_width="0dp"
            android:layout_height="46dp"
            android:layout_weight="1"
            android:background="@drawable/bg_bottom_button_ripple"
            android:padding="12dp"
            android:scaleType="fitCenter"
            android:src="@drawable/ic_back"
            android:contentDescription="رجوع" />

        <ImageButton
            android:id="@+id/homeButton"
            android:layout_width="0dp"
            android:layout_height="46dp"
            android:layout_weight="1"
            android:background="@drawable/bg_bottom_button_ripple"
            android:padding="12dp"
            android:scaleType="fitCenter"
            android:src="@drawable/ic_home"
            android:contentDescription="الرئيسية" />

        <ImageButton
            android:id="@+id/menuButton"
            android:layout_width="0dp"
            android:layout_height="46dp"
            android:layout_weight="1"
            android:background="@drawable/bg_bottom_button_ripple"
            android:padding="12dp"
            android:scaleType="fitCenter"
            android:src="@drawable/ic_menu"
            android:contentDescription="القائمة" />

        <ImageButton
            android:id="@+id/downloadsButton"
            android:layout_width="0dp"
            android:layout_height="46dp"
            android:layout_weight="1"
            android:background="@drawable/bg_bottom_button_ripple"
            android:padding="12dp"
            android:scaleType="fitCenter"
            android:src="@drawable/ic_download"
            android:contentDescription="التحميلات" />

        <Button
            android:id="@+id/tabsButton"
            android:layout_width="0dp"
            android:layout_height="46dp"
            android:layout_weight="1"
            android:background="@drawable/bg_bottom_button_ripple"
            android:textColor="#FFFFFF"
            android:textSize="15sp"
            android:textStyle="bold"
            android:text="1" />
    </LinearLayout>

    <ImageButton
        android:id="@+id/cyberFab"
        android:layout_width="60dp"
        android:layout_height="60dp"
        android:layout_gravity="bottom|end"
        android:layout_marginEnd="18dp"
        android:layout_marginBottom="96dp"
        android:background="@drawable/bg_fab_glow"
        android:padding="16dp"
        android:scaleType="fitCenter"
        android:src="@drawable/ic_terminal"
        android:contentDescription="الوضع السيبراني"
        android:elevation="12dp" />

    <FrameLayout
        android:id="@+id/fullscreenContainer"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#000000"
        android:visibility="gone" />

    <FrameLayout
        android:id="@+id/lockOverlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@drawable/bg_gradient_v2"
        android:visibility="visible">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:orientation="vertical"
            android:gravity="center">

            <ImageButton
                android:id="@+id/lockIcon"
                android:layout_width="56dp"
                android:layout_height="56dp"
                android:background="@null"
                android:padding="4dp"
                android:scaleType="fitCenter"
                android:src="@drawable/ic_lock"
                android:contentDescription="مقفل"
                android:layout_marginBottom="16dp"
                android:clickable="false"
                android:focusable="false" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="التطبيق مقفل"
                android:textColor="#FFFFFF"
                android:textSize="20sp"
                android:textStyle="bold"
                android:layout_marginBottom="20dp" />

            <Button
                android:id="@+id/unlockButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="فتح القفل" />
        </LinearLayout>
    </FrameLayout>

    <FrameLayout
        android:id="@+id/cyberContainer"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@drawable/bg_cyber_container"
        android:visibility="gone">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:paddingHorizontal="16dp"
                android:paddingTop="20dp"
                android:paddingBottom="14dp"
                android:gravity="center_vertical">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="horizontal"
                    android:background="@drawable/bg_cyber_header_badge"
                    android:paddingHorizontal="14dp"
                    android:paddingVertical="8dp"
                    android:gravity="center_vertical">

                    <ImageButton
                        android:layout_width="20dp"
                        android:layout_height="20dp"
                        android:background="@null"
                        android:padding="0dp"
                        android:scaleType="fitCenter"
                        android:src="@drawable/ic_terminal"
                        android:contentDescription=""
                        android:clickable="false"
                        android:focusable="false"
                        android:layout_marginEnd="8dp" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="الوضع السيبراني"
                        android:textColor="#00FF41"
                        android:textSize="15sp"
                        android:fontFamily="monospace"
                        android:textStyle="bold" />
                </LinearLayout>

                <ImageButton
                    android:id="@+id/cyberCloseButton"
                    android:layout_width="38dp"
                    android:layout_height="38dp"
                    android:layout_marginStart="10dp"
                    android:background="@null"
                    android:padding="4dp"
                    android:scaleType="fitCenter"
                    android:src="@drawable/ic_close_circle"
                    android:contentDescription="إغلاق" />
            </LinearLayout>

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="@drawable/divider_glow" />

            <FrameLayout
                android:id="@+id/cyberEditorArea"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:padding="14dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/cyberActiveFileLabel"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="لا يوجد ملف مفتوح"
                        android:textColor="#66FF8A"
                        android:textSize="12sp"
                        android:fontFamily="monospace"
                        android:layout_marginBottom="8dp" />

                    <ScrollView
                        android:layout_width="match_parent"
                        android:layout_height="0dp"
                        android:layout_weight="1">

                        <EditText
                            android:id="@+id/cyberEditor"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:background="@null"
                            android:gravity="top|start"
                            android:textColor="#3DFF7A"
                            android:textColorHint="#2A5533"
                            android:hint="افتح ملف من قائمة الملفات لبدء الكتابة"
                            android:textSize="14sp"
                            android:fontFamily="monospace"
                            android:inputType="textMultiLine|textNoSuggestions"
                            android:enabled="false"
                            android:minLines="10" />
                    </ScrollView>
                </LinearLayout>
            </FrameLayout>

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="@drawable/divider_glow" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:padding="12dp"
                android:gravity="center">

                <Button
                    android:id="@+id/cyberFilesButton"
                    android:layout_width="0dp"
                    android:layout_height="64dp"
                    android:layout_weight="1"
                    android:layout_margin="5dp"
                    android:background="@drawable/bg_cyber_button_selector"
                    android:drawableTop="@drawable/ic_files"
                    android:drawablePadding="4dp"
                    android:textColor="#00FF41"
                    android:textSize="10sp"
                    android:fontFamily="monospace"
                    android:text="ملفات" />

                <Button
                    android:id="@+id/cyberTerminalButton"
                    android:layout_width="0dp"
                    android:layout_height="64dp"
                    android:layout_weight="1"
                    android:layout_margin="5dp"
                    android:background="@drawable/bg_cyber_button_selector"
                    android:drawableTop="@drawable/ic_terminal"
                    android:drawablePadding="4dp"
                    android:textColor="#00FF41"
                    android:textSize="10sp"
                    android:fontFamily="monospace"
                    android:text="ترمينال" />

                <Button
                    android:id="@+id/cyberPackagesButton"
                    android:layout_width="0dp"
                    android:layout_height="64dp"
                    android:layout_weight="1"
                    android:layout_margin="5dp"
                    android:background="@drawable/bg_cyber_button_selector"
                    android:drawableTop="@drawable/ic_package"
                    android:drawablePadding="4dp"
                    android:textColor="#00FF41"
                    android:textSize="10sp"
                    android:fontFamily="monospace"
                    android:text="مكتبات" />

                <Button
                    android:id="@+id/cyberSnippetsButton"
                    android:layout_width="0dp"
                    android:layout_height="64dp"
                    android:layout_weight="1"
                    android:layout_margin="5dp"
                    android:background="@drawable/bg_cyber_button_selector"
                    android:drawableTop="@drawable/ic_snippet"
                    android:drawablePadding="4dp"
                    android:textColor="#00FF41"
                    android:textSize="10sp"
                    android:fontFamily="monospace"
                    android:text="أكواد" />
            </LinearLayout>
        </LinearLayout>

        <FrameLayout
            android:id="@+id/cyberPanel"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_marginTop="76dp"
            android:layout_marginBottom="92dp"
            android:layout_marginHorizontal="14dp"
            android:background="@drawable/bg_cyber_panel_v2"
            android:elevation="6dp"
            android:visibility="gone">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:orientation="vertical"
                android:padding="18dp">

                <TextView
                    android:id="@+id/cyberPanelTitle"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text=""
                    android:textColor="#00FF41"
                    android:textSize="16sp"
                    android:fontFamily="monospace"
                    android:textStyle="bold"
                    android:layout_marginBottom="4dp" />

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:layout_marginBottom="14dp"
                    android:background="@drawable/divider_glow" />

                <LinearLayout
                    android:id="@+id/cyberFileManagerContainer"
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:visibility="gone">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:layout_marginBottom="8dp">

                        <TextView
                            android:id="@+id/cyberPathLabel"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="/"
                            android:textColor="#66FF8A"
                            android:textSize="12sp"
                            android:fontFamily="monospace"
                            android:singleLine="true"
                            android:ellipsize="start" />

                        <Button
                            android:id="@+id/cyberUpButton"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:minWidth="0dp"
                            android:padding="6dp"
                            android:background="@drawable/bg_cyber_button_selector"
                            android:textColor="#00FF41"
                            android:textSize="11sp"
                            android:text="⬆ للأعلى" />
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:layout_marginBottom="10dp">

                        <Button
                            android:id="@+id/cyberNewFileButton"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:layout_marginEnd="6dp"
                            android:background="@drawable/bg_cyber_button_selector"
                            android:textColor="#00FF41"
                            android:textSize="11sp"
                            android:text="＋ ملف جديد" />

                        <Button
                            android:id="@+id/cyberNewFolderButton"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:background="@drawable/bg_cyber_button_selector"
                            android:textColor="#00FF41"
                            android:textSize="11sp"
                            android:text="＋ مجلد جديد" />
                    </LinearLayout>

                    <ScrollView
                        android:layout_width="match_parent"
                        android:layout_height="0dp"
                        android:layout_weight="1">

                        <LinearLayout
                            android:id="@+id/cyberFileListContainer"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="vertical" />
                    </ScrollView>
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/cyberTerminalContainer"
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:visibility="gone">

                    <ScrollView
                        android:layout_width="match_parent"
                        android:layout_height="0dp"
                        android:layout_weight="1"
                        android:layout_marginBottom="10dp">

                        <TextView
                            android:id="@+id/cyberTerminalOutput"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text=""
                            android:textColor="#66FF8A"
                            android:textSize="12sp"
                            android:fontFamily="monospace" />
                    </ScrollView>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:layout_marginBottom="8dp">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text=">>>"
                            android:textColor="#00FF41"
                            android:textSize="14sp"
                            android:fontFamily="monospace"
                            android:layout_marginEnd="6dp" />

                        <EditText
                            android:id="@+id/cyberCommandInput"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:background="@null"
                            android:hint="اكتب أمر بايثون هنا..."
                            android:textColor="#3DFF7A"
                            android:textColorHint="#2A5533"
                            android:textSize="13sp"
                            android:fontFamily="monospace"
                            android:inputType="text"
                            android:imeOptions="actionGo"
                            android:singleLine="true" />
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal">

                        <Button
                            android:id="@+id/cyberRunCommandButton"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:layout_marginEnd="6dp"
                            android:background="@drawable/bg_cyber_button_selector"
                            android:textColor="#00FF41"
                            android:textSize="12sp"
                            android:text="▶ تنفيذ الأمر" />

                        <Button
                            android:id="@+id/cyberRunButton"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:layout_marginEnd="6dp"
                            android:background="@drawable/bg_cyber_button_selector"
                            android:textColor="#00FF41"
                            android:textSize="12sp"
                            android:text="▶ تشغيل الملف" />

                        <Button
                            android:id="@+id/cyberClearTerminalButton"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:background="@drawable/bg_cyber_button_selector"
                            android:textColor="#00FF41"
                            android:textSize="12sp"
                            android:text="🧹 مسح" />
                    </LinearLayout>
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/cyberPackagesContainer"
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:visibility="gone">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:layout_marginBottom="10dp">

                        <EditText
                            android:id="@+id/cyberPackageInput"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:layout_marginEnd="6dp"
                            android:background="@drawable/bg_cyber_button_selector"
                            android:hint="اسم المكتبة (مثال: numpy)"
                            android:textColor="#3DFF7A"
                            android:textColorHint="#2A5533"
                            android:textSize="12sp"
                            android:fontFamily="monospace"
                            android:paddingHorizontal="10dp"
                            android:singleLine="true" />

                        <Button
                            android:id="@+id/cyberInstallPackageButton"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:background="@drawable/bg_cyber_button_selector"
                            android:textColor="#00FF41"
                            android:textSize="11sp"
                            android:text="⬇ تثبيت" />
                    </LinearLayout>

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="المكتبات المثبتة:"
                        android:textColor="#66FF8A"
                        android:textSize="12sp"
                        android:fontFamily="monospace"
                        android:layout_marginBottom="6dp" />

                    <ScrollView
                        android:layout_width="match_parent"
                        android:layout_height="0dp"
                        android:layout_weight="1">

                        <LinearLayout
                            android:id="@+id/cyberPackageListContainer"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="vertical" />
                    </ScrollView>
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/cyberSnippetsContainer"
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:visibility="gone">

                    <Button
                        android:id="@+id/cyberAddSnippetButton"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="10dp"
                        android:background="@drawable/bg_cyber_button_selector"
                        android:textColor="#00FF41"
                        android:textSize="12sp"
                        android:text="＋ إضافة كود جديد" />

                    <ScrollView
                        android:layout_width="match_parent"
                        android:layout_height="0dp"
                        android:layout_weight="1">

                        <LinearLayout
                            android:id="@+id/cyberSnippetListContainer"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="vertical" />
                    </ScrollView>
                </LinearLayout>

            </LinearLayout>
        </FrameLayout>

        <WebView
            android:id="@+id/pyodideWebView"
            android:layout_width="1dp"
            android:layout_height="1dp"
            android:visibility="invisible" />

    </FrameLayout>

</FrameLayout>
